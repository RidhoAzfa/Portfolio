# ═══════════════════════════════════════════════════════
# GLOBAL .gitignore for Hail Myself projects
# Put this in every project. Never commit secrets.
# ═══════════════════════════════════════════════════════

# ── SECRETS — NEVER COMMIT THESE ────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
secrets/
.secrets/
credentials.json
service-account.json
*_credentials.json
*_service_account.json

# ── NODE.JS ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
dist/
build/
.next/
.nuxt/
.output/
.cache/
*.tsbuildinfo

# ── PYTHON ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
*.egg-info/
dist/
*.so

# ── DATABASES ────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.sql.bak
prisma/migrations/*.sql.bak

# ── OS FILES ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.Spotlight-V100
.Trashes
ehthumbs.db

# ── EDITORS ──────────────────────────────────────────────
.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
.fleet/

# ── LOGS ─────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ── TESTING ──────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
.playwright/

# ── VERCEL ───────────────────────────────────────────────
.vercel/

# ── DOCKER ───────────────────────────────────────────────
.docker/

# ── MISC ─────────────────────────────────────────────────
*.bak
*.tmp
*.temp
.turbo/
.vercel
